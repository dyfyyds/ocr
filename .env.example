# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=pm_root_2026
MYSQL_DATABASE=project_management
MYSQL_USER=pm_user
MYSQL_PASSWORD=pm_user_2026
MYSQL_PORT=3306

# ---------- 后端 (FastAPI) ----------
BACKEND_PORT=8080
